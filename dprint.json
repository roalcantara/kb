{
  "lineWidth": 120,
  "indentWidth": 2,
  "markdown": { "lineWidth": 120 },
  "json": { "preferSingleLine": true },
  "typescript": { "semiColons": "asi", "quoteStyle": "preferSingle", "trailingCommas": "never" },
  "exec": { "commands": [{ "command": "shfmt -i {{indent_width}} --apply-ignore", "exts": ["sh", "bash"] }] },
  "excludes": [
    "target/**",
    "tmp/**",
    "crates/kb-domain/tests/fixtures/**",
    "tools/bench/fixtures/**",
    "bench/ts/kb",
    "bench/ts/node_modules/**",
    "bench/ts/dist/**",
    "docs/experiment/results/**",
    "TODO.md",
    "crates/third-party/block/**",
    "**/*.lock",
    "bench/ts/bun.lock"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  ]
}
