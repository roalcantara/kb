{
  "preset": "conventional",
  "rules": {
    "header-max-length": [2, "always", 72],
    "subject-case": [2, "always", "sentence-case"],
    "subject-full-stop": [2, "never", "."],
    "type-enum": [2, "always", ["feat", "fix", "chore", "docs", "style", "ref", "perf", "test", "build", "ci"]]
  }
}
